{
  "name": "snift",
  "version": "0.1.0",
  "description": "Sniff out secrets before they enter Git history.",
  "main": "dist/cli.js",
  "bin": {
    "snift": "dist/cli.js"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc && node -e \"if (process.platform !== 'win32') { try { require('fs').chmodSync('dist/cli.js', 0o755); } catch {} }\"",
    "dev": "ts-node src/cli.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hacktoberfest-Hackday-x-Graphilla/Team-wasted-tokens.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Hacktoberfest-Hackday-x-Graphilla/Team-wasted-tokens/issues"
  },
  "homepage": "https://github.com/Hacktoberfest-Hackday-x-Graphilla/Team-wasted-tokens#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "ora": "^5.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
