# Gemma configuration
GEMMA_PROVIDER=local
GEMMA_MODEL=gemma4:e2b
# Ollama example: http://localhost:11434/v1/chat/completions
# (use the /v1/chat/completions URL, NOT /api/generate)
GEMMA_ENDPOINT=
GEMMA_ENABLED=true

# Optional: override the blocking confidence threshold (0-1)
SNIFT_CONFIDENCE_THRESHOLD=0.85
